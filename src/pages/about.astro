---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import { PROFILE } from '@/consts'
import Layout from '@/layouts/layout.astro'

// Сторінка «Метод»: як влаштовано кожне розслідування на сайті.
const rules = [
  {
    n: '01',
    title: 'Число — лише з документа',
    text: 'Кожна сума, дата, відсоток і кількість у тексті стоїть у процитованому джерелі. Якщо підтвердження немає — числа в тексті немає.',
  },
  {
    n: '02',
    title: 'Виноска веде на першоджерело',
    text: 'Реєстр, декларація, судове рішення, звіт, допис самого фігуранта. Досьє, огляди й довідки — лише шлях до документа, а не джерело.',
  },
  {
    n: '03',
    title: 'Цитата — дослівно',
    text: 'Слова людей подаємо мовою оригіналу й без переказу. Оцінки належать тим, хто їх висловив, і підписані їхніми іменами.',
  },
  {
    n: '04',
    title: 'Презумпція невинуватості',
    text: 'Підозра — не вина, обвинувачення — не вирок. Статус кожної справи вказуємо так, як він записаний у судових документах.',
  },
  {
    n: '05',
    title: 'Персональні дані — мінімально',
    text: 'Адреси, телефони, дати народження приватних осіб не публікуємо, навіть якщо вони є у відкритих реєстрах.',
  },
  {
    n: '06',
    title: 'Виправлення — відкрито',
    text: 'Кожна публікація — коміт у відкритому репозиторії. Історія правок видна всім.',
  },
]
const isExternal = (href: string) => /^https?:\/\//.test(href)
---

<Layout variant="immersive">
  <PageHead slot="head" title="Метод" description={PROFILE.summary} />

  <section
    class="relative overflow-hidden border-b border-white/10 bg-black/30"
  >
    <div
      class="landing-dot-mass absolute top-0 right-[-6rem] h-[20rem] w-[20rem] opacity-[0.22] sm:right-[-4rem] sm:h-[28rem] sm:w-[28rem] lg:h-[34rem] lg:w-[34rem]"
    >
    </div>
    <div
      class="mx-auto max-w-[1400px] px-4 py-12 sm:px-6 sm:py-14 lg:px-8 lg:py-20"
    >
      <Breadcrumbs
        variant="immersive"
        items={[{ label: 'Метод', icon: 'lucide:info' }]}
      />

      <div
        class="mt-8 grid gap-10 xl:grid-cols-[minmax(0,1.2fr)_minmax(280px,0.8fr)] xl:items-end"
      >
        <div class="immersive-animate-in max-w-4xl" transition:name="page-intro">
          <p class="landing-section-label">Як ми працюємо</p>
          <h1
            class="mt-4 text-[clamp(2.4rem,5vw,4.6rem)] leading-[0.95] font-semibold tracking-[-0.06em] text-balance text-white"
          >
            Розслідування, які можна перевірити
          </h1>
          <p
            class="immersive-copy mt-6 max-w-2xl text-base leading-7 sm:text-lg sm:leading-8"
          >
            {PROFILE.summary}
          </p>
        </div>

        <aside class="immersive-panel immersive-animate-in self-start xl:self-end">
          <p class="immersive-eyebrow">Посилання</p>
          <div class="mt-5 border-t border-white/8">
            {
              PROFILE.links.map((item) => (
                <Link
                  href={item.href}
                  external={isExternal(item.href)}
                  class="group flex items-center justify-between gap-4 border-b border-white/8 py-3.5"
                >
                  <span class="font-mono text-[0.74rem] tracking-[0.28em] text-white/70 uppercase group-hover:text-white">
                    {item.label}
                  </span>
                  <span class="text-right text-sm text-white/42">{item.note}</span>
                </Link>
              ))
            }
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="bg-[#040404]">
    <div
      class="mx-auto max-w-[1400px] px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20"
    >
      <div class="max-w-3xl space-y-5">
        {
          PROFILE.about.map((p) => (
            <p class="text-base leading-8 text-white/68 sm:text-lg">{p}</p>
          ))
        }
      </div>

      <div
        class="mt-12 grid gap-px border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          rules.map((r) => (
            <article class="bg-[#050505] px-6 py-7 sm:px-7 sm:py-8">
              <p class="font-mono text-[0.68rem] tracking-[0.3em] text-white/34">
                {r.n}
              </p>
              <h2 class="mt-4 text-[1.35rem] leading-tight font-semibold tracking-[-0.04em] text-white">
                {r.title}
              </h2>
              <p class="mt-3 text-sm leading-7 text-white/58">{r.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
